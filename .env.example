# PostgreSQL local (docker-compose)
DATABASE_URL="postgresql://pet:pets_dev@localhost:5432/petsolidario?schema=public"

# Auth: use a random 32+ character value in every environment
AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"

# Azure Blob Storage / Azurite. For local dev the compose service is provided.
AZURE_STORAGE_CONNECTION_STRING="UseDevelopmentStorage=true"
AZURE_STORAGE_CONTAINER="pet-media"
# Used by Azurite; production can set the public URL of a read-enabled container/CDN.
AZURE_BLOB_PUBLIC_BASE_URL="http://127.0.0.1:10000/devstoreaccount1/pet-media"

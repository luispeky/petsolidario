generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PetStatus {
  AVAILABLE
  IN_TREATMENT
  ADOPTED
}

enum RequestStatus {
  NEW
  IN_PROGRESS
  CLOSED
}

model Organization {
  id           String     @id @default(cuid())
  name         String
  slug         String     @unique
  email        String     @unique
  passwordHash String
  phone        String?
  city         String
  state        String
  description  String    @db.Text
  imageUrl     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  pets         Pet[]
  campaigns    Campaign[]
  requests     ContactRequest[]
}

model Pet {
  id             String      @id @default(cuid())
  name           String
  species        String
  breed          String?
  age            String
  sex            String
  size           String
  description    String      @db.Text
  imageUrl       String?
  status         PetStatus   @default(AVAILABLE)
  city           String
  state          String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status, species])
  @@index([organizationId])
}

model Campaign {
  id                 String       @id @default(cuid())
  title              String
  description        String       @db.Text
  goalCents          Int
  raisedCents        Int          @default(0)
  donationInstructions String     @db.Text
  imageUrl           String?
  endsAt             DateTime?
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([organizationId])
}

model ContactRequest {
  id             String        @id @default(cuid())
  name           String
  email          String
  phone          String?
  message        String        @db.Text
  type           String        @default("CONTACT")
  status         RequestStatus @default(NEW)
  petId          String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())

  @@index([organizationId, status])
}
